# Inner Caddy used on the Oracle host. The existing edge proxy terminates TLS
# and forwards msg.yunjelee.com to loopback port 8080.
:80 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy backend:5000 {
			# The only host listener is loopback and cloudflared supplies this
			# header. Preserve the real edge client IP for API rate limiting.
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}
	handle /socket.io/* {
		# Caddy forwards WebSocket upgrades automatically.
		reverse_proxy backend:5000 {
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}
	handle /health {
		reverse_proxy backend:5000 {
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}

	# A hashed chunk that a deploy has already removed must 404 here: the
	# catch-all below rewrites every missing path to index.html, and
	# @staticAssets would then pin that HTML under the .js URL for a year,
	# which nothing on the server side can invalidate.
	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@staticAssets {
		path /assets/*
		# Gates the year-long cache on the file actually being on disk, so the
		# 404 above is not itself cached immutably.
		file {
			root /srv
		}
	}
	header @staticAssets Cache-Control "public, max-age=31536000, immutable"
	@appShell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @appShell Cache-Control "no-cache"

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' wss://{$SECUREMSG_DOMAIN}; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# camera=(self): the QR pairing scanner needs getUserMedia on this
		# origin. camera=() silently made the web approver flow impossible.
		Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
	}
}
